<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLands</title>
    <link crossorigin="anonymous" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body class="d-flex text-center text-white bg-dark">
    <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
        <header class="mb-auto">
            <div>
                <h3 class="float-md-start mb-0">WanderLands</h3>
                <nav class="nav nav-masthead justify-content-center float-md-end">
                    <a href="#" class="nav-link active" aria-current="page">Home</a>
                    <a href="/listings" class="nav-link">Listings</a>
                    <% if(!currentUser) { %>                        
                        <a href="/login" class="nav-link">Login</a>
                        <a href="/register" class="nav-link">Register</a>
                    <% } else { %>
                        <a href="/logout" class="nav-link">Logout</a>
                    <% } %>
                </nav>
            </div>
        </header>
        <main class="px-3">
            <h1 class="hero-title">WanderLands</h1>
            <p class="lead hero-copy">Welcome to WanderLands! <br> Jump right in and explore our many listings. <br>
                Feel free to share some of your own and comment on others!</p>
            <a href="/listings" class="btn btn-large btn-secondary fw-bold text-width border-white bg-white">View Listings</a>
        </main>

        <footer class="mt-auto text-white-50">
            <p>&copy; 2025 WanderLands</p>
        </footer>

    </div>


    
</body>
    <script crossorigin="anonymous" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</html>